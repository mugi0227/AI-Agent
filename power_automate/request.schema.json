{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "action",
    "arguments",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "enum": [
        "search_mail",
        "get_calendar",
        "get_transcript",
        "search_sharepoint"
      ]
    },
    "arguments": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
